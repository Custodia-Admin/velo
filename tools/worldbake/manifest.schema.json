{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Custodia-Admin/velo/tools/worldbake/manifest.schema.json",
  "title": "Velo world bundle manifest (format velo-world, version 1)",
  "description": "public/worlds/<id>/manifest.json. Prose spec: docs/worlds/WORLD-FORMAT.md. Runtime validator: src/lib/world/manifest.ts (kept in step by manifest.test.ts).",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "name",
    "origin",
    "projection",
    "extent",
    "bbox",
    "heightfield",
    "layers",
    "files",
    "moods",
    "defaultMood",
    "pois",
    "routes",
    "stats",
    "credits",
    "generator"
  ],
  "properties": {
    "format": { "const": "velo-world" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": { "lat": { "type": "number" }, "lon": { "type": "number" } }
    },
    "projection": {
      "type": "object",
      "description": "Local transverse Mercator: x east, y north, metres, (0,0) at (lat0, lon0).",
      "required": ["type", "ellipsoid", "lat0", "lon0", "k0"],
      "properties": {
        "type": { "const": "tmerc" },
        "ellipsoid": { "const": "WGS84" },
        "lat0": { "type": "number" },
        "lon0": { "type": "number" },
        "k0": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "extent": {
      "type": "object",
      "description": "World rectangle in metres; equals the heightfield grid.",
      "required": ["xMin", "xMax", "yMin", "yMax"],
      "properties": {
        "xMin": { "type": "number" },
        "xMax": { "type": "number" },
        "yMin": { "type": "number" },
        "yMax": { "type": "number" }
      }
    },
    "bbox": {
      "type": "object",
      "description": "WGS84 bounding box of the extent (rounded outward to 1e-5 degrees).",
      "required": ["south", "west", "north", "east"],
      "properties": {
        "south": { "type": "number" },
        "west": { "type": "number" },
        "north": { "type": "number" },
        "east": { "type": "number" }
      }
    },
    "heightfield": {
      "type": "object",
      "required": ["file", "cols", "rows", "cellSize", "encoding", "heightOffset", "heightScale", "minHeight", "maxHeight"],
      "properties": {
        "file": { "type": "string" },
        "cols": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "encoding": { "const": "u16-delta" },
        "heightOffset": { "type": "number" },
        "heightScale": { "type": "number", "exclusiveMinimum": 0 },
        "minHeight": { "type": "number" },
        "maxHeight": { "type": "number" }
      }
    },
    "layers": {
      "type": "object",
      "required": ["roads", "water", "landcover", "buildings", "vegetation", "routes"],
      "additionalProperties": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "compression", "contentBytes", "contentSha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "compression": { "enum": ["gzip", "none"] },
          "contentBytes": { "type": "integer", "minimum": 0 },
          "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "moods": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "defaultMood": { "type": "string" },
    "pois": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "x", "y", "h", "osm"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["town", "village", "peak", "viewpoint", "landmark", "church"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "h": { "type": "number" },
          "osm": { "type": "string", "pattern": "^(node|way|relation)/[0-9]+$" },
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lengthM", "maxGapM", "gradeMeanAbsDiffPct"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lengthM": { "type": "number" },
          "maxGapM": { "type": "number", "minimum": 0 },
          "gradeMeanAbsDiffPct": { "type": "number", "minimum": 0 }
        }
      }
    },
    "stats": { "type": "object", "additionalProperties": { "type": "number" } },
    "credits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "licence", "url", "attribution"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "licence": { "type": "string" },
          "url": { "type": "string" },
          "attribution": { "type": "string" }
        }
      }
    },
    "generator": {
      "type": "object",
      "required": ["tool", "version", "recipeSha256", "osmDate", "demSource", "demZoom", "demTiles"],
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "recipeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "osmDate": { "type": "string" },
        "demSource": { "type": "string" },
        "demZoom": { "type": "integer" },
        "demTiles": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
