# ──────────────────────────────────────────────────────────────────────────────
# Velo — environment variables (all optional)
# Copy what you need to .env.local (gitignored). NEVER commit real secrets.
# Velo runs with none of these set: its own worlds need no token or key.
# ──────────────────────────────────────────────────────────────────────────────

# Cesium ion token: adds the photoreal Cesium view for routes outside a baked
# world. Free for personal use at https://ion.cesium.com/tokens
# Without it those routes ride on an OpenStreetMap map.
VITE_CESIUM_ION_TOKEN=

# Where remote world bundles (e.g. Chengdu) are fetched from. Default: the
# project's public R2 bucket. Point it at a self-hosted mirror with the same
# <id>/<hash>/ layout (docs/worlds/ADDING-A-WORLD.md, "Hosting").
# VITE_WORLDS_REMOTE_URL=https://worlds.example.com/worlds/

# Household labels: "1" titles the featured worlds "Home · Perugia" and
# "Hometown · Lugano" on Home instead of the place names alone. For a private
# deploy only (docs/architecture/ADR-002-publishing.md). Put it in
# .env.production.local (and .env.development.local for the dev server) so the
# unit tests, which read neither file, keep testing the public titles.
# VITE_HOUSEHOLD_LABELS=1

# ──────────────────────────────────────────────────────────────────────────────
# AI (optional; inherited from GlobeRide)
# ──────────────────────────────────────────────────────────────────────────────

# Provider selection: 'xai' | 'ollama' | 'auto'
# 'auto' (default) → uses xAI when VITE_XAI_API_KEY is set, else Ollama.
VITE_AI_PROVIDER=auto

# xAI (Grok) — OpenAI-compatible API
# Key:   https://console.x.ai  — never commit a real key
# Model: default is grok-4.3 (change to any supported xAI chat model)
# CORS:  browser → /xai (Vite proxy) → https://api.x.ai
#        In production expose /xai via your hosting proxy or a serverless fn.
VITE_XAI_API_KEY=
VITE_XAI_MODEL=grok-4.3

# Ollama — local inference, no key needed
# Run:   ollama serve && ollama pull llama3.1
# URL:   default http://localhost:11434 (no CORS issues — same origin / localhost)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1
